{
  "window.title": "PythonPlugin",
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8",
    "editor.formatOnSave": true
  },
  "autopep8.args": [
    "--max-line-length=150"
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "build": true,
    "builds": true,
    "dist": true,
    "**/**.egg-info/": true,
    ".venv/": true
  },
  "debug.inlineValues": "on",
  "cSpell.words": [
    "codesign",
    "Correr",
    "datas",
    "engineio",
    "finalizer",
    "hiddenimports",
    "hooksconfig",
    "hookspath",
    "Laufen",
    "linebuf",
    "MEIPASS",
    "ndtkit",
    "nicegui",
    "noarchive",
    "noconsole",
    "pathex",
    "pyinstaller",
    "refreshable",
    "uvicorn"
  ]
}